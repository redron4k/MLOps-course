@@ -0,0 +1,78 @@
+"""Contract fixtures prove the wrapper actually recomputes scores and the HW67 gate."""
+import copy
+import json
+from pathlib import Path
+import tempfile
+import unittest
+
+from gate import HW67, verify_evaluation
+from evaluation.solution import score
+from release import canonical,digest
+
+
+class SourceGateTests(unittest.TestCase):
+    def setUp(self):
+        self.temp=tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.root=Path(self.temp.name)
+        self.rows=[dict(id=f'q{i}',input='Question',choices=['A','B'],expected='A',
+                        slices=['critical','second','third']) for i in range(50)]
+        self.behaviors=[{**row,'id':f'b{i}'} for i,row in enumerate(self.rows[:3])]
+        self.outputs=[dict(id=r['id'],raw='{"answer":"A"}',error=None) for r in self.rows+self.behaviors]
+        self.protocol=dict(config={'critical_slices':['critical']},golden=self.rows,
+            behavioral=self.behaviors,scoring_sha256=digest((HW67/'evaluation/solution.py').read_bytes()),
+            backend_sha256=digest((Path(__file__).resolve().parents[1]/'backend.py').read_bytes()))
+        self.spec=dict(kind='adapter',name='test',version='1',run_id='training-fixture',uri='fixture://adapter')
+        self.manifest=dict(kind='adapter',model_spec=self.spec,model_sha256='a'*64,
+            runtime_sha256='b'*64,protocol_sha256=digest(canonical(self.protocol)),
+            golden_sha256=digest(canonical(self.rows)))
+        full=score(self.rows,self.outputs[:50])
+        full.update(status='complete',model=self.spec,behavioral=score(self.behaviors,self.outputs[50:]),
+            protocol_sha256=self.manifest['protocol_sha256'],golden_sha256=self.manifest['golden_sha256'],
+            baseline_spec_sha256='c'*64,model_sha256='a'*64,runtime_sha256='b'*64,
+            evaluation_run_id='evaluation-fixture',outputs_sha256=digest(canonical(self.outputs)))
+        baseline=copy.deepcopy(full)
+        baseline['model']=dict(kind='base',name='base-fixture',revision='f'*40)
+        self.documents={'protocol.json':self.protocol,'baseline-eval.json':baseline,'candidate-eval.json':full,
+                        'baseline-outputs.json':self.outputs,'candidate-outputs.json':copy.deepcopy(self.outputs)}
+        self.report=dict(synthetic=False,passed=True,metrics=full['overall'],evaluation_run_id='evaluation-fixture')
+        self.save()
+
+    def save(self):
+        self.report['sources']={}
+        for name,document in self.documents.items():
+            path=self.root/name
+            path.write_bytes(canonical(document))
+            self.report['sources'][name]=dict(uri=str(path),sha256=digest(path.read_bytes()))
+
+    def test_complete_raw_evidence_passes(self):
+        verify_evaluation(self.manifest,self.report)
+
+    def test_changed_source_rejected(self):
+        (self.root/'candidate-outputs.json').write_text('[]')
+        with self.assertRaisesRegex(ValueError,'source changed'):
+            verify_evaluation(self.manifest,self.report)
+
+    def test_rehashed_raw_cannot_hide_stale_scores(self):
+        self.documents['candidate-outputs.json'][0]['raw']='{"answer":"B"}'
+        full=self.documents['candidate-eval.json']
+        full['outputs_sha256']=digest(canonical(self.documents['candidate-outputs.json']))
+        self.save()
+        with self.assertRaisesRegex(ValueError,'Metrics differ'):
+            verify_evaluation(self.manifest,self.report)
+
+    def test_fabricated_pass_cannot_override_full_quality_gate(self):
+        outputs=self.documents['candidate-outputs.json']
+        outputs[0]['raw']='{"answer":"B"}'
+        full=self.documents['candidate-eval.json']
+        full.update(score(self.rows,outputs[:50]))
+        full['outputs_sha256']=digest(canonical(outputs))
+        self.report['metrics']=full['overall']
+        self.save()
+        with self.assertRaisesRegex(ValueError,'Регрессия общей accuracy'):
+            verify_evaluation(self.manifest,self.report)
+
+    def test_runtime_binding_cannot_be_relabelled(self):
+        self.manifest['runtime_sha256']='d'*64
+        with self.assertRaisesRegex(ValueError,'binding mismatch'):
+            verify_evaluation(self.manifest,self.report)
diff --git a/hw8910/integration_tests/test_incidents.py b/hw8910/integration_tests/test_incidents.py
new file mode 100644
index 0000000..f6f06e1
--- /dev/null
+++ b/hw8910/integration_tests/test_incidents.py
@@ -0,0 +1,174 @@
+"""The same real process/HTTP scenarios run against the original and both adapters."""
+import contextlib
+import hashlib
+import json
+import os
+from pathlib import Path
+import socket
+import subprocess
+import sys
+import tempfile
+import time
+import unittest
+import urllib.error
+import urllib.request
+from unittest.mock import patch
+
+import lab
+import release
+
+PROJECT = Path(__file__).resolve().parents[1]
+
+
+class IncidentTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.root = Path(self.temp.name) / 'workspace'
+        lab.initialize(self.root)
+
+    def command(self, *args):
+        extra = ['--engine', 'prefect'] if os.getenv('FLOW_ENGINE') == 'prefect' else []
+        result = subprocess.run([sys.executable, str(PROJECT / 'lab.py'), '--workspace',
+                                 str(self.root), 'run', *args, *extra],
+                                capture_output=True, text=True, timeout=120)
+        print(json.dumps(dict(command=list(args), exit_code=result.returncode,
+                              stdout=result.stdout, stderr=result.stderr), ensure_ascii=False))
+        return result
+
+    def pointer_hash(self):
+        return hashlib.sha256((self.root / 'accepted.json').read_bytes()).hexdigest()
+
+    @contextlib.contextmanager
+    def server(self, warmup=0):
+        with socket.socket() as sock:
+            sock.bind(('127.0.0.1', 0))
+            port = sock.getsockname()[1]
+        extra = ['--engine', 'fastapi'] if os.getenv('HTTP_ENGINE') == 'fastapi' else []
+        with tempfile.TemporaryFile(mode='w+') as log:
+            process = subprocess.Popen([sys.executable, str(PROJECT / 'service.py'),
+                '--workspace', str(self.root), '--port', str(port),
+                '--warmup-seconds', str(warmup), *extra], stdout=log, stderr=log)
+            try:
+                def request(path, body=None):
+                    data = None if body is None else json.dumps(body).encode()
+                    req = urllib.request.Request(f'http://127.0.0.1:{port}{path}', data=data,
+                                                 headers={'Content-Type': 'application/json'})
+                    try:
+                        opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
+                        with opener.open(req, timeout=10) as response:
+                            return response.status, json.load(response)
+                    except urllib.error.HTTPError as exc:
+                        return exc.code, json.load(exc)
+                deadline = time.monotonic() + 30
+                while True:
+                    try:
+                        request('/health')
+                        break
+                    except OSError:
+                        if time.monotonic() > deadline or process.poll() is not None:
+                            log.seek(0)
+                            self.fail('Server failed: ' + log.read())
+                        time.sleep(.025)
+                yield request
+            finally:
+                process.terminate()
+                try:
+                    process.wait(timeout=10)
+                except subprocess.TimeoutExpired:
+                    process.kill()
+                    process.wait()
+
+    def test_subprocess_recovery_and_content_cache(self):
+        self.assertNotEqual(self.command('--fail-after-prepare').returncode, 0)
+        result = self.command()
+        self.assertEqual(result.returncode, 0)
+        self.assertTrue('CACHE_HIT' in result.stdout+result.stderr or 'Cached' in result.stdout+result.stderr)
+        (self.root / 'input.txt').write_text('Changed bytes at the same path\n')
+        result = self.command()
+        self.assertEqual(result.returncode, 0)
+        self.assertIn('PREPARED', result.stdout+result.stderr)
+        for key, value in [('template_sha256', 'f'*64), ('max_length', 64),
+                           ('tokenizer_revision', 'r2'), ('code_revision', 'prepare-v2')]:
+            config = lab.read(self.root / 'config.json')
+            config[key] = value
+            lab.write(self.root / 'config.json', config)
+            result = self.command()
+            self.assertIn('PREPARED', result.stdout+result.stderr)
+
+    def test_subprocess_incomplete_foreign_reject_preserve_pointer(self):
+        before = self.pointer_hash()
+        for name in ['report-reject.json', 'report-incomplete.json', 'report-A.json']:
+            with self.subTest(report=name):
+                self.assertNotEqual(self.command('--report', name).returncode, 0)
+                after = self.pointer_hash()
+                print('POINTER', name, before, after)
+                self.assertEqual(before, after)
+
+    def test_atomic_disk_failure(self):
+        before = self.pointer_hash()
+        with patch('os.replace', side_effect=OSError('injected disk failure')):
+            with self.assertRaises(OSError):
+                release.publish(lab.read(self.root/'manifest-B.json'),
+                                lab.read(self.root/'report-B.json'), self.root/'accepted.json')
+        self.assertEqual(before, self.pointer_hash())
+        self.assertFalse(list(self.root.glob('*.tmp')))
+
+    def test_subprocess_repeat_publication(self):
+        self.assertEqual(self.command().returncode, 0)
+        self.assertEqual(self.command().returncode, 0)
+        events = [json.loads(line) for line in (self.root/'publications.jsonl').read_text().splitlines()]
+        self.assertEqual(len(events), 1)
+        self.assertEqual(events[0]['model_id'], 'fixture-B')
+
+    def test_http_readiness_blocks_backend_until_warmup(self):
+        with self.server(warmup=2) as request:
+            self.assertEqual(request('/health')[0], 200)
+            self.assertEqual(request('/ready')[0], 503)
+            calls = request('/debug')[1]['calls']
+            self.assertEqual(request('/generate', {'prompt': 'hello'})[0], 503)
+            self.assertEqual(request('/debug')[1]['calls'], calls)
+            deadline = time.monotonic()+10
+            while request('/ready')[0] != 200 and time.monotonic() < deadline:
+                time.sleep(.05)
+            self.assertEqual(request('/ready')[0], 200)
+            self.assertTrue(request('/debug')[1]['warmup_finished'])
+            self.assertEqual(request('/generate', {'prompt': 'hello'})[0], 200)
+
+    def test_http_loaded_version_and_rollback(self):
+        payload = {'prompt': 'hello', 'max_new_tokens': 32}
+        with self.server() as request:
+            self.assertEqual(request('/generate', payload)[1]['model_id'], 'fixture-A')
+            self.assertEqual(self.command().returncode, 0)
+            answer = request('/generate', payload)[1]
+            self.assertIn('fixture-A', answer['answer'])
+            self.assertEqual(answer['model_id'], 'fixture-A')
+        with self.server() as request:
+            answer = request('/generate', payload)[1]
+            self.assertEqual(answer['model_id'], 'fixture-B')
+            self.assertIn('fixture-B', answer['answer'])
+        release.publish(lab.read(self.root/'manifest-A.json'), lab.read(self.root/'report-A.json'),
+                        self.root/'accepted.json')
+        with self.server() as request:
+            answer = request('/generate', payload)[1]
+            self.assertEqual(answer['model_id'], 'fixture-A')
+            self.assertIn('fixture-A', answer['answer'])
+
+    def test_http_invalid_requests_never_call_backend(self):
+        with self.server() as request:
+            calls = request('/debug')[1]['calls']
+            for payload in [{'prompt': ''}, {'prompt': 'x', 'max_new_tokens': 0},
+                            {'prompt': 'x', 'max_new_tokens': 100000},
+                            {'prompt': 'x', 'max_new_tokens': '32'}]:
+                with self.subTest(payload=payload):
+                    status, _ = request('/generate', payload)
+                    self.assertTrue(400 <= status < 500, status)
+                    self.assertEqual(request('/debug')[1]['calls'], calls)
+            status, answer = request('/generate', {'prompt': 'valid', 'max_new_tokens': 32})
+            self.assertEqual(status, 200)
+            self.assertTrue(answer['request_id'])
+            self.assertEqual(request('/debug')[1]['calls'], calls+1)
+
+
+if __name__ == '__main__':
+    unittest.main(verbosity=2)
diff --git a/hw8910/integration_tests/test_recovery.py b/hw8910/integration_tests/test_recovery.py
