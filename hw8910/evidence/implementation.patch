+"""Narrated 6-minute walkthrough of saved evidence; not a live screen recording.
+
+Requires the full lock (Pillow), local ffmpeg/ffprobe and macOS say/Milena.
+No network calls. Weights and environments are never embedded in the video.
+"""
+import json
+from pathlib import Path
+import subprocess
+import tempfile
+import textwrap
+import sys
+
+ROOT=Path(__file__).resolve().parents[1]
+sys.path.insert(0,str(ROOT))
+
+
+def build():
+    from PIL import Image,ImageDraw,ImageFont
+    decision=json.loads((ROOT/'evidence/real-release/release-decision.json').read_text())
+    benchmark=json.loads((ROOT/'evidence/real-api/benchmark/summary.json').read_text())
+    smoke=json.loads((ROOT/'evidence/real-api/smoke.json').read_text())[0]
+    scenes=[
+('01 / Задача и происхождение',
+ ['ДЗ 8 + 9 + 10: проверяемый выпуск модели','',
+  'Исходный commit: 1837801','Training: '+decision['training_run_id'],
+  'Eval HW67: '+decision['prior_evaluation_run_id'],
+  'Новый eval: '+decision['evaluation_run_id'],'',
+  'Это обзор сохранённых проверяемых журналов.','STUB-опыты и реальные ответы показаны отдельно.'],
+ 'В этой работе нужно было связать процесс выпуска, проверку качества и обслуживание модели. Сначала сохранён исходный сломанный прототип отдельным коммитом. Затем написаны свои интеграционные тесты. Я показываю сохранённые журналы выполненных команд, а не имитирую живое выполнение. Синтетические версии используются только для инженерных проверок. Реальная часть переиспользует обучение из шестого и седьмого домашних заданий. Повторного поиска параметров нет. Новый запуск оценки связывает точные веса и настройки генерации с версией, которую действительно загружает сервис.'),
+('02 / Семь независимых причин',
+ ['1. Ключ кеша использовал путь вместо содержимого.',
+  '2. Gate проверял truthiness поля passed.',
